---
/** Páginas interiores (aviso de privacidad, 404, futuros servicios y artículos). */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import MobileCta from '@/components/MobileCta.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <Header isHome={false} />
  <main id="contenido-principal">
    <slot />
  </main>
  <Footer isHome={false} />
  <MobileCta />
</BaseLayout>
