---
/**
 * /dev/sistema — muestrario vivo del sistema «Margen».
 * Solo existe en `npm run dev` (ver integrations/dev-routes.mjs).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import Folio from '@/components/ui/Folio.astro';
import Mark from '@/components/ui/Mark.astro';
import Photo from '@/components/ui/Photo.astro';
import { site } from '@/config/site';

const hex = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16) / 255);
const lum = (h: string) => {
  const [r, g, b] = hex(h).map((c) => (c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4));
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
const ratio = (a: string, b: string) => {
  const [l1, l2] = [lum(a), lum(b)].sort((x, y) => y - x);
  return (l1 + 0.05) / (l2 + 0.05);
};

const swatches = [
  { name: 'Warm Ivory', token: '--c-ivory', hex: '#f5f2ec', role: 'Fondo base · 70 %' },
  { name: 'Charcoal', token: '--c-charcoal', hex: '#202020', role: 'Texto · capítulos oscuros · 22 %' },
  { name: 'Burnt Orange', token: '--c-orange', hex: '#d66b3d', role: 'Acento gráfico · 2 %' },
  { name: 'Warm Gray', token: '--c-warm-gray', hex: '#b7b1a7', role: 'Filetes · texto secundario en oscuro' },
  { name: 'Pure White', token: '--c-white', hex: '#ffffff', role: 'Ficha de servicios' },
  { name: 'Orange Deep', token: '--c-orange-deep', hex: '#a84c26', role: 'Derivado · texto naranja en claro' },
  { name: 'Ink Muted', token: '--c-ink-muted', hex: '#6b665e', role: 'Derivado · texto secundario en claro' },
];

const pairs = [
  ['Charcoal / Ivory', '#202020', '#f5f2ec'],
  ['Ink Muted / Ivory', '#6b665e', '#f5f2ec'],
  ['Orange Deep / Ivory', '#a84c26', '#f5f2ec'],
  ['Burnt Orange / Ivory', '#d66b3d', '#f5f2ec'],
  ['Blanco / Burnt Orange', '#ffffff', '#d66b3d'],
  ['Warm Gray / Ivory', '#b7b1a7', '#f5f2ec'],
  ['Ivory / Charcoal', '#f5f2ec', '#202020'],
  ['Warm Gray / Charcoal', '#b7b1a7', '#202020'],
  ['Burnt Orange / Charcoal', '#d66b3d', '#202020'],
].map(([label, fg, bg]) => {
  const r = ratio(fg, bg);
  return { label, fg, bg, r: r.toFixed(2), verdict: r >= 4.5 ? 'AA texto' : r >= 3 ? 'Solo ≥ 24 px / gráfico' : 'Solo decorativo' };
});

const scale = [
  { token: '--step-display', sample: 'No siempre necesitas', cls: 'display' },
  { token: '--step-h2', sample: 'Hay cosas que necesitan un espacio', cls: 'h2' },
  { token: '--step-h3', sample: 'Ansiedad y sobrepensamiento', cls: 'h3' },
  { token: '--step-lead', sample: 'A veces, el primer paso es encontrar un espacio donde puedas hablar.', cls: 'lead' },
  { token: '--step-body', sample: 'Mi trabajo parte de reconocer que cada persona tiene una historia.', cls: 'body' },
  { token: '--step-label', sample: 'Psicoterapia en Monterrey y en línea', cls: 'label' },
];
---

<BaseLayout title="Sistema · Margen" noindex>
  <main class="sys">
    <header class="sys__head grid">
      <Folio number="00">Sistema de diseño</Folio>
      <h1 class="sys__title">Margen<span style="color: var(--accent)">.</span></h1>
      <p class="lead muted">
        Sistema visual de {site.person.displayName}. Muestrario vivo: todo lo que aparece aquí sale de los mismos
        tokens y componentes que usa el sitio.
      </p>
    </header>

    <section class="sys__block grid">
      <Folio number="01">Color</Folio>
      <ul role="list" class="swatches">
        {
          swatches.map((s) => (
            <li class="swatch">
              <span class="swatch__chip" style={`background: var(${s.token})`} />
              <strong>{s.name}</strong>
              <code>{s.hex.toUpperCase()}</code>
              <span class="muted">{s.role}</span>
            </li>
          ))
        }
      </ul>
      <table class="contrast">
        <caption class="label muted">Contraste WCAG</caption>
        <tbody>
          {
            pairs.map((p) => (
              <tr>
                <td>
                  <span class="contrast__sample" style={`color:${p.fg};background:${p.bg}`}>
                    Aa
                  </span>
                </td>
                <td>{p.label}</td>
                <td>
                  <code>{p.r}:1</code>
                </td>
                <td class="muted">{p.verdict}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <section class="sys__block grid">
      <Folio number="02">Tipografía</Folio>
      <div class="scale">
        {
          scale.map((s) => (
            <div class="scale__row">
              <code class="muted">{s.token}</code>
              <p class:list={['scale__sample', `scale__sample--${s.cls}`, { label: s.cls === 'label' }]}>{s.sample}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="sys__block grid">
      <Folio number="03">Gestos</Folio>
      <div class="gestures">
        <h2 class="gestures__h">
          Entenderte también es una forma de <Mark>avanzar</Mark><span style="color: var(--accent)">.</span>
        </h2>
        <div class="gestures__row">
          <Button href="#">Agendar una consulta</Button>
          <Button href="#" variant="text">Conoce mi trabajo</Button>
          <Button href="#" external variant="text">Doctoralia</Button>
        </div>
      </div>
    </section>

    <section class="sys__block grid" data-tone="dark">
      <Folio number="04">Capítulo oscuro</Folio>
      <div class="gestures">
        <h2 class="gestures__h">Cada persona tiene una historia que merece ser <Mark>escuchada</Mark>.</h2>
        <div class="gestures__row">
          <Button href="#">Agendar una consulta</Button>
          <Button href="#" variant="text">Conoce mi trabajo</Button>
        </div>
      </div>
    </section>

    <section class="sys__block grid">
      <Folio number="05">Retícula y fotografía</Folio>
      <div class="cols" aria-hidden="true">
        {Array.from({ length: 12 }, (_, i) => <span>{i + 1}</span>)}
      </div>
      <div class="photos">
        <Photo photo={site.photos.hero} alt="" ratio="4 / 5" label="Hero · 4:5" sizes="30vw" />
        <Photo photo={site.photos.about} alt="" ratio="3 / 4" label="Sobre mí · 3:4" sizes="30vw" />
        <Photo photo={site.photos.hero} alt="" ratio="21 / 9" label="Respiro · 21:9" sizes="60vw" class="photos__wide" />
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .sys {
    padding-bottom: var(--space-8);
  }

  .sys__head {
    padding-block: var(--space-7) var(--space-5);
    row-gap: var(--space-3);
  }

  .sys__title {
    font-size: var(--step-display);
    line-height: var(--leading-display);
  }

  .sys__block {
    padding-block: var(--space-6);
    row-gap: var(--space-4);
    border-top: var(--hairline) solid var(--rule);
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: var(--space-3) var(--gutter);
  }

  .swatch {
    display: grid;
    gap: 0.25rem;
    font-size: var(--step-small);
  }

  .swatch__chip {
    aspect-ratio: 4 / 3;
    margin-bottom: var(--space-1);
    outline: var(--hairline) solid var(--rule);
  }

  .contrast {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step-small);
  }

  .contrast caption {
    text-align: left;
    padding-bottom: var(--space-2);
  }

  .contrast td {
    padding: 0.5rem 0.75rem 0.5rem 0;
    border-top: var(--hairline) solid var(--rule);
  }

  .contrast__sample {
    display: inline-grid;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
  }

  .scale {
    display: grid;
    gap: var(--space-4);
  }

  .scale__row {
    display: grid;
    gap: var(--space-1);
  }

  .scale__sample--display {
    font-family: var(--font-display);
    font-size: var(--step-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .scale__sample--h2 {
    font-family: var(--font-display);
    font-size: var(--step-h2);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-display);
  }

  .scale__sample--h3 {
    font-family: var(--font-display);
    font-size: var(--step-h3);
    line-height: 1.2;
  }

  .scale__sample--lead {
    font-size: var(--step-lead);
    max-width: 40ch;
  }

  .gestures {
    display: grid;
    gap: var(--space-4);
  }

  .gestures__h {
    font-size: var(--step-h2);
    max-width: 18ch;
  }

  .gestures__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: var(--gutter);
  }

  .cols span {
    display: grid;
    place-items: end center;
    height: 6rem;
    padding-bottom: 0.25rem;
    background: color-mix(in srgb, var(--c-orange) 10%, transparent);
    font-size: 0.75rem;
    color: var(--accent-text);
  }

  .cols span:nth-child(n + 5) {
    display: none;
  }

  @media (min-width: 48rem) {
    .cols span:nth-child(-n + 8) {
      display: grid;
    }
  }

  @media (min-width: 64rem) {
    .cols span {
      display: grid !important;
    }
  }

  .photos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gutter);
  }

  .photos :global(.photos__wide) {
    grid-column: 1 / -1;
  }
</style>
