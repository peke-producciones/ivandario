---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import MobileCta from '@/components/MobileCta.astro';
import Hero from '@/components/sections/Hero.astro';
import Reasons from '@/components/sections/Reasons.astro';
import About from '@/components/sections/About.astro';
import Approach from '@/components/sections/Approach.astro';
import Services from '@/components/sections/Services.astro';
import Content from '@/components/sections/Content.astro';
import Faq from '@/components/sections/Faq.astro';
import Contact from '@/components/sections/Contact.astro';
---

<BaseLayout>
  <Header isHome />
  <main id="contenido-principal">
    <Hero />
    <Reasons />
    <About />
    <Approach />
    <Services />
    <Content />
    <Faq />
    <Contact />
  </main>
  <Footer isHome />
  <MobileCta />
</BaseLayout>
