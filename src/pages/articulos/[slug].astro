---
import { getCollection, render } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import Button from '@/components/ui/Button.astro';
import Folio from '@/components/ui/Folio.astro';
import { site } from '@/config/site';
import { url } from '@/lib/url';

export async function getStaticPaths() {
  const published = await getCollection('articulos', ({ data }) => !data.draft);
  return published.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const fmt = new Intl.DateTimeFormat('es-MX', { dateStyle: 'long' });
const pageUrl = new URL(url(`/articulos/${entry.id}/`), Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.date.toISOString(),
  dateModified: (entry.data.updated ?? entry.data.date).toISOString(),
  inLanguage: 'es-MX',
  mainEntityOfPage: pageUrl,
  author: { '@type': 'Person', name: site.person.fullName, jobTitle: site.person.profession },
};
---

<PageLayout title={`${entry.data.title} · ${site.person.displayName}`} description={entry.data.description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <article class="post grid">
    <header class="post__head">
      <Folio><a href={url('/articulos/')}>Artículos</a></Folio>
      <h1 class="post__title">{entry.data.title}</h1>
      <p class="label muted">
        <time datetime={entry.data.date.toISOString()}>{fmt.format(entry.data.date)}</time> · {site.person.displayName}
      </p>
    </header>
    <div class="post__body prose">
      <Content />
    </div>
    <aside class="post__cta">
      <p>Si algo de esto resuena contigo, podemos conversarlo.</p>
      <Button href={site.links.doctoralia} external track="doctoralia">Agendar una consulta</Button>
    </aside>
  </article>
</PageLayout>

<style>
  .post {
    padding-block: var(--space-6) var(--section-y);
    row-gap: var(--space-5);
  }

  .post__head {
    display: grid;
    gap: var(--space-2);
  }

  .post__title {
    font-size: var(--step-h2);
    max-width: 20ch;
  }

  .post__body {
    font-size: 1.125rem;
  }

  .post__body :global(h2) {
    font-size: var(--step-h3);
    margin-top: var(--space-5);
  }

  .post__body :global(a) {
    color: var(--accent-text);
  }

  .post__cta {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    padding-top: var(--space-4);
    border-top: var(--hairline) solid var(--rule-strong);
  }

  .post__cta p {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-figure);
  }

  @media (min-width: 64rem) {
    .post > :global(*) {
      grid-column: col-start 3 / col-end 10;
    }
  }
</style>
