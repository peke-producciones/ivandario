---
import PageLayout from '@/layouts/PageLayout.astro';
import Button from '@/components/ui/Button.astro';
import Folio from '@/components/ui/Folio.astro';
import Mark from '@/components/ui/Mark.astro';
import { site } from '@/config/site';
import { url } from '@/lib/url';
---

<PageLayout title={`Página no encontrada · ${site.person.displayName}`} description="Esta página no existe." noindex>
  <section class="nf grid">
    <Folio number="404">Página no encontrada</Folio>
    <h1 class="nf__title">No todo camino lleva a donde esperábamos. <Mark trigger="load">Volvamos</Mark>.</h1>
    <div class="nf__actions">
      <Button href={url('/')}>Ir al inicio</Button>
      <Button href={site.links.doctoralia} variant="text" external track="doctoralia">Agendar una consulta</Button>
    </div>
  </section>
</PageLayout>

<style>
  .nf {
    padding-block: var(--space-7) var(--section-y);
    row-gap: var(--space-4);
    min-height: 60svh;
    align-content: center;
  }

  .nf__title {
    font-size: var(--step-h2);
    max-width: 18ch;
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
  }
</style>
