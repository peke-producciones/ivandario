---
/**
 * Marcador visible de información pendiente.
 * Solo se muestra con `preview.showPending = true` (vista previa).
 * Con la vista previa apagada no renderiza nada.
 *   <Pending label="Cédula profesional" />
 */
import { site } from '@/config/site';

interface Props {
  label: string;
  block?: boolean;
  class?: string;
}
const { label, block = false, class: className } = Astro.props;
const show = site.preview.showPending;
---

{
  show && (
    <span class:list={['pending', { 'pending--block': block }, className]} data-pending>
      <span class="pending__tag">Pendiente</span>
      <span class="pending__label">{label}</span>
    </span>
  )
}

<style>
  .pending {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.625rem;
    padding: 0.375rem 0.625rem;
    border: 1px dashed var(--accent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--c-orange) 7%, transparent);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-style: normal;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0;
    text-transform: none;
    color: var(--fg);
  }

  /* Sobre fondo oscuro, sin tinte: mantiene el contraste AA del naranja */
  :global([data-tone='dark']) .pending {
    background: transparent;
  }

  .pending--block {
    display: flex;
    width: 100%;
  }

  .pending__tag {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
</style>
