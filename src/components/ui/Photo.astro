---
/**
 * Fotografía editorial.
 * - Foto confirmada → <picture> AVIF/WebP responsivo optimizado en el build.
 * - Pendiente, en desarrollo o vista previa → bloque rotulado «Pendiente».
 * - Pendiente, en lanzamiento → no se renderiza nada.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { valueOf, type Field } from '@/lib/pending';
import { showPhotoPlaceholders } from '@/lib/photos';

interface Props {
  photo: Field<ImageMetadata>;
  alt: string;
  /** Proporción del recorte, p. ej. "4 / 5" */
  ratio: string;
  /** Nombre del encuadre para el marcador provisional */
  label: string;
  sizes: string;
  priority?: boolean;
  class?: string;
}

const { photo, alt, ratio, label, sizes, priority = false, class: className } = Astro.props;
const image = valueOf(photo);
const showPlaceholder = !image && showPhotoPlaceholders();
---

{
  image ? (
    <figure class:list={['photo', className]} style={`--ratio: ${ratio}`}>
      <Picture
        src={image}
        alt={alt}
        formats={['avif', 'webp']}
        widths={[480, 720, 960, 1280, 1600, 2000].filter((w) => w <= image.width)}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding={priority ? 'sync' : 'async'}
        class="photo__img"
      />
    </figure>
  ) : (
    showPlaceholder && (
      <figure class:list={['photo', 'photo--placeholder', className]} style={`--ratio: ${ratio}`} data-pending>
        <figcaption class="label">
          <span class="photo__tag">Pendiente · Fotografía</span>
          <span>{label}</span>
        </figcaption>
      </figure>
    )
  )
}

<style>
  .photo {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--c-ivory-deep);
  }

  .photo :global(.photo__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo--placeholder {
    display: grid;
    place-items: end start;
    padding: var(--space-3);
    background:
      linear-gradient(
        to top right,
        transparent calc(50% - 0.5px),
        color-mix(in srgb, var(--c-warm-gray) 80%, transparent) 50%,
        transparent calc(50% + 0.5px)
      ),
      color-mix(in srgb, var(--c-warm-gray) 38%, var(--c-ivory));
    color: var(--c-ink-muted);
  }

  .photo--placeholder figcaption {
    display: grid;
    gap: 0.25rem;
  }

  .photo--placeholder figcaption span {
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .photo--placeholder .photo__tag {
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--c-orange-deep);
  }
</style>
