---
import Button from '@/components/ui/Button.astro';
import Mark from '@/components/ui/Mark.astro';
import Section from '@/components/ui/Section.astro';
import { reasons } from '@/content/reasons';
import { site } from '@/config/site';

const letters = 'ABCDEFGHIJ';
---

<Section id="motivos" number="01" label="Motivos de consulta">
  <h2 id="motivos-title" class="section-title">
    Hay cosas que necesitan un espacio para ser <Mark>comprendidas</Mark>.
  </h2>

  <ol role="list" class="reasons">
    {
      reasons.map((r, i) => (
        <li class="reason" data-reveal style={`--reveal-i: ${i % 3}`}>
          <span class="reason__letter" aria-hidden="true">
            {letters[i]}
          </span>
          <h3 class="reason__title">{r.title}</h3>
          <p class="reason__text">{r.text}</p>
        </li>
      ))
    }
  </ol>

  <div class="reasons__close" data-reveal>
    <p>Si te reconoces en alguno de estos momentos, podemos empezar por conversarlo.</p>
    <Button href={site.links.doctoralia} variant="text" external track="doctoralia">Agendar una consulta</Button>
  </div>
</Section>

<style>
  .reasons {
    border-top: var(--hairline) solid var(--rule-strong);
  }

  .reason {
    display: grid;
    grid-template-columns: 2rem 1fr;
    column-gap: var(--space-2);
    row-gap: var(--space-1);
    padding-block: var(--space-4);
    border-bottom: var(--hairline) solid var(--rule);
  }

  .reason__letter {
    grid-row: 1;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-h3);
    line-height: 1.2;
    color: var(--accent-text);
  }

  .reason__title {
    grid-row: 1;
    font-size: var(--step-h3);
    line-height: 1.2;
    letter-spacing: -0.01em;
    transition: transform var(--dur) var(--ease-out);
  }

  .reason__text {
    grid-column: 2;
    max-width: 46ch;
    color: var(--fg-muted);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .reason:hover .reason__title {
      transform: translateX(0.375rem);
    }
  }

  @media (min-width: 48rem) {
    .reason {
      grid-template-columns: 3rem minmax(0, 1fr) minmax(0, 1.15fr);
      column-gap: var(--gutter);
      align-items: baseline;
      padding-block: var(--space-5);
    }

    .reason__text {
      grid-column: 3;
      grid-row: 1;
    }
  }

  .reasons__close {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
  }

  .reasons__close p {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-figure);
    line-height: 1.3;
    max-width: 30ch;
  }
</style>
