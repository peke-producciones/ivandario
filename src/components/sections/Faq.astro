---
import Mark from '@/components/ui/Mark.astro';
import Pending from '@/components/ui/Pending.astro';
import Section from '@/components/ui/Section.astro';
import { faq } from '@/content/faq';
import { site } from '@/config/site';
import { isConfirmed } from '@/lib/pending';

const cancellationPending = !isConfirmed(site.policies.cancellation);
---

<Section id="preguntas" number="06" label="Preguntas frecuentes">
  <div class="faq">
    <div class="faq__intro">
      <h2 id="preguntas-title" class="section-title">Lo que suele preguntarse antes de <Mark>empezar</Mark>.</h2>
      <p class="faq__note">
        Estas respuestas son orientativas y no sustituyen una valoración profesional. Si tienes otra duda, puedes
        escribirme.
      </p>
    </div>

    <div class="faq__list">
      {
        faq.map((item, i) => (
          <details class="qa" name="faq">
            <summary class="qa__q">
              <span class="qa__n label" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="qa__text">{item.q}</span>
              <span class="qa__icon" aria-hidden="true" />
            </summary>
            <div class="qa__a prose">
              {item.a.map((p) => (
                <p>{p}</p>
              ))}
              {i === faq.length - 1 && cancellationPending && <Pending label="Condiciones de cancelación y reservación" />}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</Section>

<style>
  .faq {
    display: grid;
    gap: var(--space-5);
  }

  .faq__intro {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .faq__note {
    max-width: 36ch;
    color: var(--fg-muted);
    font-size: var(--step-small);
  }

  .faq__list {
    border-top: var(--hairline) solid var(--rule-strong);
  }

  .qa {
    border-bottom: var(--hairline) solid var(--rule);
  }

  .qa__q {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) 1.25rem;
    align-items: baseline;
    gap: var(--space-1);
    padding-block: var(--space-3);
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: clamp(1.1875rem, 1.05rem + 0.5vw, 1.5rem);
    line-height: 1.3;
  }

  .qa__q::-webkit-details-marker {
    display: none;
  }

  .qa__n {
    color: var(--accent-text);
  }

  .qa__icon {
    position: relative;
    inline-size: 1rem;
    block-size: 1rem;
    align-self: center;
  }

  .qa__icon::before,
  .qa__icon::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--dur) var(--ease-out);
  }

  .qa__icon::after {
    transform: rotate(90deg);
  }

  .qa[open] .qa__icon::after {
    transform: rotate(0deg);
  }

  .qa__q:hover .qa__text {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  .qa__a {
    padding: 0 0 var(--space-4) calc(2.25rem + var(--space-1));
    color: var(--fg-muted);
    max-width: calc(var(--measure) + 3rem);
  }

  @media (prefers-reduced-motion: no-preference) {
    .qa[open] .qa__a {
      animation: qa-in 360ms var(--ease-out);
    }
  }

  @keyframes qa-in {
    from {
      opacity: 0;
      transform: translateY(-0.375rem);
    }
  }

  @media (min-width: 64rem) {
    .faq {
      grid-template-columns: minmax(0, 4fr) minmax(0, 6fr);
      column-gap: calc(var(--gutter) * 2);
    }

    .faq__intro {
      position: sticky;
      top: calc(var(--header-h) + var(--space-5));
    }
  }
</style>
