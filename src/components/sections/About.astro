---
import Mark from '@/components/ui/Mark.astro';
import Pending from '@/components/ui/Pending.astro';
import Photo from '@/components/ui/Photo.astro';
import Section from '@/components/ui/Section.astro';
import { site } from '@/config/site';
import { valueOf } from '@/lib/pending';
import { hasPhotoSlot } from '@/lib/photos';

const withPhoto = hasPhotoSlot(site.photos.about);
const { credentials } = site;

/** Bloques de trayectoria: se muestran confirmados, o marcados como pendientes en vista previa. */
const blocks = [
  { label: 'Formación académica', value: valueOf(credentials.education), pending: 'Universidad y títulos académicos' },
  { label: 'Especializaciones', value: valueOf(credentials.certifications), pending: 'Diplomados y certificaciones' },
  { label: 'Experiencia', value: valueOf(credentials.experience), pending: 'Experiencia clínica' },
  { label: 'Cédula profesional', value: valueOf(credentials.license), pending: 'Número de cédula profesional' },
];
const showBlocks = blocks.some((b) => b.value) || site.preview.showPending;
---

<Section id="sobre-mi" number="02" label="Sobre mí" tone="dark" class:list={[withPhoto ? 'about--photo' : 'about--type']}>
  <h2 id="sobre-mi-title" class="section-title about__title">
    Cada persona tiene una historia que merece ser <Mark>escuchada</Mark>.
  </h2>

  {
    withPhoto && (
      <div class="about__media" data-reveal>
        <Photo
          photo={site.photos.about}
          alt={`Retrato de ${site.person.displayName}`}
          ratio="3 / 4"
          label="Sobre mí · retrato 3:4"
          sizes="(min-width: 64rem) 38vw, 90vw"
        />
      </div>
    )
  }

  <div class="about__text">
    <div class="prose">
      <p class="about__lead">
        Soy {site.person.displayName}, psicoterapeuta. Mi trabajo parte de reconocer que cada persona tiene una historia,
        una manera particular de experimentar el mundo y circunstancias que no pueden reducirse a una etiqueta o
        diagnóstico.
      </p>
      <p>
        Busco ofrecer un espacio de escucha, reflexión y acompañamiento donde puedas explorar aquello que estás viviendo,
        comprender tus propias experiencias y construir nuevas posibilidades.
      </p>
    </div>

    <p class="about__sign">
      <span class="about__sign-rule" aria-hidden="true"></span>
      <span>{site.person.fullName}<span class="muted">, {site.person.profession.toLowerCase()}</span></span>
    </p>

    {
      showBlocks && (
        <dl class="creds">
          {blocks.map((b) =>
            b.value ? (
              <div class="cred">
                <dt class="label">{b.label}</dt>
                <dd>
                  {Array.isArray(b.value) ? (
                    <ul role="list">
                      {b.value.map((v) => (
                        <li>{v}</li>
                      ))}
                    </ul>
                  ) : (
                    b.value
                  )}
                </dd>
              </div>
            ) : (
              site.preview.showPending && (
                <div class="cred">
                  <dt class="label">{b.label}</dt>
                  <dd>
                    <Pending label={b.pending} />
                  </dd>
                </div>
              )
            ),
          )}
        </dl>
      )
    }
  </div>
</Section>

<style>
  .about__lead {
    font-size: var(--step-lead);
    line-height: 1.5;
  }

  .about__text {
    display: grid;
    gap: var(--space-4);
  }

  .about__text p:not(.about__lead) {
    color: var(--fg-muted);
  }

  .about__sign {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-figure);
  }

  .about__sign-rule {
    inline-size: 2rem;
    block-size: 2px;
    background: var(--accent);
    flex: none;
  }

  .about__media {
    grid-column: col-start 1 / full;
  }

  .creds {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-3);
    border-top: var(--hairline) solid var(--rule);
  }

  .cred {
    display: grid;
    gap: 0.5rem;
  }

  .cred dt {
    color: var(--fg-muted);
  }

  .cred dd {
    margin: 0;
  }

  @media (min-width: 48rem) {
    .about__media {
      grid-column: full-start / col-end 5;
    }

    :global(.about--photo) .about__text {
      grid-column: col-start 6 / content-end;
      align-self: end;
    }

    .creds {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--gutter);
    }
  }

  @media (min-width: 64rem) {
    .about__title {
      grid-column: col-start 3 / col-end 11;
    }

    .about__media {
      grid-column: full-start / col-end 6;
    }

    :global(.about--photo) .about__text {
      grid-column: col-start 7 / content-end;
    }

    :global(.about--type) .about__text {
      grid-column: col-start 3 / col-end 10;
    }
  }
</style>
