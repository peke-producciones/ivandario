---
/**
 * Barra de acción inferior (solo móvil). Aparece cuando el hero sale de la
 * pantalla y se oculta al llegar a la sección de contacto.
 * WhatsApp se añade solo cuando el número está confirmado en site.ts.
 */
import Button from '@/components/ui/Button.astro';
import { site } from '@/config/site';
import { valueOf } from '@/lib/pending';

const whatsapp = valueOf(site.contact.whatsapp);
---

<div class="mobile-cta" data-mobile-cta>
  <Button href={site.links.doctoralia} external track="doctoralia" block>Agendar consulta</Button>
  {
    whatsapp && (
      <a
        class="mobile-cta__wa"
        href={`https://wa.me/${whatsapp}`}
        target="_blank"
        rel="noopener"
        data-track="whatsapp"
        aria-label="Escribir por WhatsApp (se abre en una pestaña nueva)"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.2c0-.1-.2-.2-.5-.3Z"
          />
        </svg>
      </a>
    )
  }
</div>

<style>
  .mobile-cta {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 40;
    display: flex;
    gap: var(--space-1);
    padding: var(--space-1) var(--margin) calc(var(--space-1) + env(safe-area-inset-bottom));
    background: color-mix(in srgb, var(--c-ivory) 94%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-top: var(--hairline) solid var(--rule);
    transition:
      transform var(--dur) var(--ease-out),
      visibility var(--dur);
  }

  :global(.js) .mobile-cta:not([data-visible]) {
    transform: translateY(100%);
    visibility: hidden;
  }

  .mobile-cta__wa {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 3.25rem;
    border: var(--hairline) solid var(--fg);
    border-radius: var(--radius);
    color: var(--fg);
  }

  .mobile-cta__wa svg {
    inline-size: 1.375rem;
  }

  @media (min-width: 48rem) {
    .mobile-cta {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-cta {
      transition: none;
    }
  }
</style>
