---
import { navigation } from '@/config/navigation';
import { site } from '@/config/site';
import Pending from '@/components/ui/Pending.astro';
import { valueOf } from '@/lib/pending';
import { url, sectionHref } from '@/lib/url';

interface Props {
  isHome?: boolean;
}
const { isHome = true } = Astro.props;
const whatsapp = valueOf(site.contact.whatsapp);
const year = new Date().getFullYear();
// Orden de lectura de la portada
const footerLinks = [
  { id: 'motivos', label: 'Motivos de consulta' },
  ...navigation.filter((n) => n.id !== 'contacto'),
  { id: 'preguntas', label: 'Preguntas frecuentes' },
  ...navigation.filter((n) => n.id === 'contacto'),
];
---

<footer class="footer" data-tone="dark" data-cta-hide>
  <div class="grid footer__grid">
    <p class="footer__mark" aria-hidden="true">
      {site.person.displayName}<span class="footer__dot">.</span>
    </p>

    <div class="footer__about">
      <p class="label footer__role">{site.person.profession} · Monterrey y en línea</p>
      <p class="footer__concept">{site.concept}</p>
    </div>

    <nav class="footer__col" aria-label="Secundaria">
      <p class="label footer__head">Secciones</p>
      <ul role="list">
        {
          footerLinks.map((item) => (
            <li>
              <a href={sectionHref(item.id, isHome)}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="footer__col">
      <p class="label footer__head">Encuéntrame</p>
      <ul role="list">
        <li>
          <a href={site.links.doctoralia} target="_blank" rel="noopener" data-track="doctoralia">
            Doctoralia <span aria-hidden="true">↗</span><span class="visually-hidden"> (se abre en una pestaña nueva)</span>
          </a>
        </li>
        <li>
          <a href={site.links.tiktok.url} target="_blank" rel="noopener" data-track="tiktok">
            TikTok <span aria-hidden="true">↗</span><span class="visually-hidden"> (se abre en una pestaña nueva)</span>
          </a>
        </li>
        <li>
          {
            whatsapp ? (
              <a href={`https://wa.me/${whatsapp}`} target="_blank" rel="noopener" data-track="whatsapp">
                WhatsApp <span aria-hidden="true">↗</span>
                <span class="visually-hidden"> (se abre en una pestaña nueva)</span>
              </a>
            ) : (
              <Pending label="WhatsApp" />
            )
          }
        </li>
      </ul>
    </div>

    <div class="footer__legal">
      <p>
        © <span data-year>{year}</span>{' '}{site.person.fullName}. Todos los derechos reservados.
      </p>
      <a href={url('/aviso-de-privacidad/')}>Aviso de privacidad</a>
    </div>
  </div>
</footer>

<script>
  document.querySelectorAll('[data-year]').forEach((el) => (el.textContent = String(new Date().getFullYear())));
</script>

<style>
  .footer {
    padding-block: var(--space-7) var(--space-4);
    overflow-x: clip;
  }

  .footer__grid {
    row-gap: var(--space-5);
  }

  .footer__mark {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 0.5rem + 14.5vw, 15rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    white-space: nowrap;
    padding-bottom: var(--space-3);
    border-bottom: var(--hairline) solid var(--rule);
  }

  .footer__dot {
    color: var(--accent);
  }

  .footer__about {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .footer__role,
  .footer__head {
    color: var(--fg-muted);
  }

  .footer__concept {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-figure);
    line-height: 1.3;
    max-width: 22ch;
  }

  .footer__col {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .footer__col ul {
    display: grid;
    gap: 0.25rem;
  }

  .footer__col a,
  .footer__legal a {
    display: inline-block;
    padding-block: 0.3rem;
    text-decoration: none;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-size: 0 1px;
    background-position: 0 90%;
    background-repeat: no-repeat;
    transition: background-size var(--dur) var(--ease-out);
  }

  .footer__col a:hover,
  .footer__legal a:hover {
    background-size: 100% 1px;
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    padding-top: var(--space-3);
    border-top: var(--hairline) solid var(--rule);
    font-size: 0.875rem;
    color: var(--fg-muted);
  }

  @media (min-width: 48rem) {
    nav.footer__col {
      grid-column: col-start 1 / col-end 4;
    }

    div.footer__col {
      grid-column: col-start 5 / content-end;
    }
  }

  @media (min-width: 64rem) {
    .footer__about {
      grid-column: col-start 1 / col-end 6;
    }

    nav.footer__col {
      grid-column: col-start 7 / col-end 9;
    }

    div.footer__col {
      grid-column: col-start 10 / content-end;
    }
  }
</style>
